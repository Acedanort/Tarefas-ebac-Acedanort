// Arquivo: ContaBancaria.java

/**
 * Classe que representa uma conta bancária simples.
 * Permite operações como depósito, saque e consulta de saldo.
 */
public class ContaBancaria {
    // Propriedades
    private String numeroConta;
    private String titular;
    private double saldo;
    private String agencia;
    private String tipoConta; // Ex: "Corrente", "Poupança"

    /**
     * Construtor da conta bancária.
     * @param numeroConta Número único da conta
     * @param titular Nome do titular da conta
     * @param agencia Agência bancária (ex: "001-X")
     * @param tipoConta Tipo da conta (ex: "Corrente")
     */
    public ContaBancaria(String numeroConta, String titular, String agencia, String tipoConta) {
        this.numeroConta = numeroConta;
        this.titular = titular;
        this.agencia = agencia;
        this.tipoConta = tipoConta;
        this.saldo = 0.0; // Saldo inicia zerado
    }

    // Métodos

    /**
     * Deposita um valor na conta.
     * @param valor Valor a ser depositado (deve ser positivo)
     */
    public void depositar(double valor) {
        if (valor > 0) {
            saldo += valor;
            System.out.println("Depósito de R$" + valor + " realizado.");
        } else {
            System.out.println("Valor inválido para depósito.");
        }
    }

    /**
     * Realiza um saque na conta (se houver saldo suficiente).
     * @param valor Valor a ser sacado
     * @return true se o saque foi bem-sucedido, false caso contrário
     */
    public boolean sacar(double valor) {
        if (valor > 0 && saldo >= valor) {
            saldo -= valor;
            System.out.println("Saque de R$" + valor + " realizado.");
            return true;
        } else {
            System.out.println("Saldo insuficiente ou valor inválido.");
            return false;
        }
    }

    /**
     * Transfere um valor para outra conta.
     * @param destino ContaBancaria que receberá o valor
     * @param valor Valor a ser transferido
     * @return true se a transferência foi bem-sucedida
     */
    public boolean transferir(ContaBancaria destino, double valor) {
        if (this.sacar(valor)) {
            destino.depositar(valor);
            System.out.println("Transferência de R$" + valor + " para " + destino.getTitular());
            return true;
        }
        return false;
    }

    /**
     * Retorna o saldo atual da conta.
     * @return Saldo em formato numérico
     */
    public double consultarSaldo() {
        return saldo;
    }

    // Getters e Setters
    public String getNumeroConta() {
        return numeroConta;
    }

    public String getTitular() {
        return titular;
    }

    public String getAgencia() {
        return agencia;
    }

    public String getTipoConta() {
        return tipoConta;
    }
}
        